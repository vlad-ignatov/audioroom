{
  "name": "audioroom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "icons": "electron scripts/build-icons.cjs",
    "dev:app": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"electron .\"",
    "electron": "electron .",
    "package:mac": "node scripts/check-target.cjs mac && npm run build && electron-builder --mac",
    "package:win": "node scripts/check-target.cjs win && npm run build && electron-builder --win",
    "package:linux": "node scripts/check-target.cjs linux && npm run build && electron-builder --linux",
    "package:unpacked": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.14.10",
    "hls.js": "^1.7.2",
    "music-metadata": "^11.15.0",
    "node-id3": "^0.2.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.5"
  },
  "main": "electron/main.cjs",
  "productName": "AudioRoom",
  "description": "Internet radio and music player",
  "author": "Vladimir Ignatov",
  "license": "MIT",
  "homepage": "https://github.com/vlad-ignatov/audioroom",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlad-ignatov/audioroom.git"
  },
  "desktopName": "audioroom.desktop",
  "build": {
    "appId": "dev.vlad.audioroom",
    "productName": "AudioRoom",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icons/512x512.png"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo"
    }
  }
}
